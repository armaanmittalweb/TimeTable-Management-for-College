# Base URL of the EduSched API (the Worker in ../api). No trailing slash. Default: https://edusched-api.amittal.dev
# Local: `cd ../api && npm run dev:local` serves it on port 8787.
VITE_API_URL=http://localhost:8787

# Set to "mock" to run against the in-memory API instead (no server needed).
# VITE_API=mock

# Optional: origins allowed to embed /embed and exchange postMessage with it (comma-separated).
# VITE_EMBED_PARENT_ORIGINS=https://www.amittal.dev,http://localhost:5173
